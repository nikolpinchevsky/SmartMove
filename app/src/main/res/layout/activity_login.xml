<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_login_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="@dimen/spacing_24"
        android:paddingEnd="@dimen/spacing_24"
        android:paddingTop="@dimen/spacing_18"
        android:paddingBottom="@dimen/spacing_24">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivHero"
            android:layout_width="@dimen/size_hero_login_width"
            android:layout_height="@dimen/size_hero_login_height"
            android:layout_marginTop="@dimen/spacing_10"
            android:layout_marginBottom="@dimen/spacing_10"
            android:contentDescription="@string/cd_hero_image"
            android:scaleType="fitCenter"
            android:src="@drawable/smartmove_hero" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/smartmove_text_primary"
            android:textSize="@dimen/text_size_header"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_6"
            android:text="@string/login_subtitle"
            android:textColor="@color/smartmove_text_secondary"
            android:textSize="@dimen/text_size_body_lg" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:layout_marginBottom="@dimen/spacing_18"
            android:background="@android:color/transparent"
            android:elevation="@dimen/elevation_card_2xl"
            android:padding="0dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="@dimen/corner_xl"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_18">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_input"
                    android:layout_marginBottom="@dimen/spacing_12"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_14"
                    android:paddingEnd="@dimen/spacing_14">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/size_icon_input"
                        android:layout_height="@dimen/size_icon_input"
                        android:src="@drawable/ic_email"
                        android:contentDescription="@string/cd_email_icon" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etEmail"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_10"
                        android:background="@android:color/transparent"
                        android:hint="@string/hint_email"
                        android:inputType="textEmailAddress"
                        android:padding="0dp"
                        android:textColor="@color/smartmove_text_primary"
                        android:textColorHint="@color/smartmove_text_secondary"
                        android:textSize="@dimen/text_size_body_lg" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_input"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_14"
                    android:paddingEnd="@dimen/spacing_14">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/size_icon_input"
                        android:layout_height="@dimen/size_icon_input"
                        android:src="@drawable/ic_lock"
                        android:contentDescription="@string/cd_password_icon" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_10"
                        android:background="@android:color/transparent"
                        android:hint="@string/hint_password"
                        android:inputType="textPassword"
                        android:padding="0dp"
                        android:textColor="@color/smartmove_text_primary"
                        android:textColorHint="@color/smartmove_text_secondary"
                        android:textSize="@dimen/text_size_body_lg" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivPasswordEye"
                        android:layout_width="@dimen/size_icon_input"
                        android:layout_height="@dimen/size_icon_input"
                        android:src="@drawable/ic_eye"
                        android:contentDescription="@string/cd_show_password" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_button_primary"
                    android:layout_marginTop="@dimen/spacing_16"
                    app:backgroundTint="@null"
                    android:background="@drawable/bg_primary_button"
                    android:text="@string/btn_login"
                    android:textAllCaps="false"
                    android:textColor="@color/smartmove_text_secondary"
                    android:textSize="@dimen/text_size_subtitle"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_18"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="@dimen/height_divider"
                        android:layout_weight="1"
                        android:background="@color/smartmove_divider" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_12"
                        android:layout_marginEnd="@dimen/spacing_12"
                        android:text="@string/label_or"
                        android:textColor="@color/smartmove_text_secondary"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="@dimen/height_divider"
                        android:layout_weight="1"
                        android:background="@color/smartmove_divider" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSignUp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_button_primary"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:background="@drawable/bg_secondary_button"
                    android:gravity="center"
                    android:text="@string/btn_sign_up"
                    android:textColor="@color/button_primary_color"
                    android:textSize="@dimen/text_size_subtitle"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
