<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_login_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_20"
        android:paddingTop="@dimen/spacing_20"
        android:paddingEnd="@dimen/spacing_20"
        android:paddingBottom="@dimen/spacing_bottom_tabs">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvSearchTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search_title"
            android:textColor="@color/smartmove_text_primary"
            android:textSize="@dimen/text_size_title_lg"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvSearchSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_6"
            android:text="@string/search_subtitle"
            android:textColor="@color/smartmove_text_secondary"
            android:textSize="@dimen/text_size_body" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_primary"
            android:layout_marginTop="@dimen/spacing_18"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_14"
            android:paddingEnd="@dimen/spacing_14">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/size_icon_input"
                android:layout_height="@dimen/size_icon_input"
                android:src="@drawable/search_icon"
                android:tint="@color/smartmove_text_secondary"
                android:contentDescription="@string/cd_search_icon" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_10"
                android:background="@android:color/transparent"
                android:hint="@string/hint_search"
                android:inputType="text"
                android:textColor="@color/smartmove_text_primary"
                android:textColorHint="@color/smartmove_text_secondary"
                android:textSize="@dimen/text_size_body_lg" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_18"
            android:text="@string/search_filters"
            android:textColor="@color/smartmove_text_primary"
            android:textSize="@dimen/text_size_subtitle"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_10"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/filterRoom"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/height_filter_chip"
                    android:layout_marginEnd="@dimen/spacing_8"
                    android:background="@drawable/bg_filter_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:paddingStart="@dimen/spacing_16"
                    android:paddingEnd="@dimen/spacing_16"
                    android:text="@string/filter_room"
                    android:textColor="@color/smartmove_text_primary"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/filterPriority"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/height_filter_chip"
                    android:layout_marginEnd="@dimen/spacing_8"
                    android:background="@drawable/bg_filter_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:paddingStart="@dimen/spacing_16"
                    android:paddingEnd="@dimen/spacing_16"
                    android:text="@string/filter_priority"
                    android:textColor="@color/smartmove_text_primary"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/filterItem"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/height_filter_chip"
                    android:layout_marginEnd="@dimen/spacing_8"
                    android:background="@drawable/bg_filter_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:paddingStart="@dimen/spacing_16"
                    android:paddingEnd="@dimen/spacing_16"
                    android:text="@string/filter_item"
                    android:textColor="@color/smartmove_text_primary"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/filterStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/height_filter_chip"
                    android:background="@drawable/bg_filter_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:paddingStart="@dimen/spacing_16"
                    android:paddingEnd="@dimen/spacing_16"
                    android:text="@string/filter_status"
                    android:textColor="@color/smartmove_text_primary"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_22"
            android:text="@string/search_results"
            android:textColor="@color/smartmove_text_primary"
            android:textSize="@dimen/text_size_title_sm"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressSearch"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvEmptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="@string/search_empty"
            android:textColor="@color/smartmove_text_secondary"
            android:textSize="@dimen/text_size_body"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSearchResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</ScrollView>
