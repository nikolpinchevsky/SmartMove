<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Pinned header: back arrow + title/subtitle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_8"
        android:paddingTop="@dimen/spacing_16"
        android:paddingEnd="@dimen/spacing_20"
        android:paddingBottom="@dimen/spacing_8">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back_button"
            android:padding="@dimen/spacing_12"
            android:src="@drawable/ic_back_arrow" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_4"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/box_details_title"
                android:textColor="@color/smartmove_text_primary"
                android:textSize="@dimen/text_size_header"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:text="@string/box_details_subtitle"
                android:textColor="@color/smartmove_text_secondary"
                android:textSize="@dimen/text_size_body" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBoxDetails"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/spacing_20"
        android:visibility="gone" />

    <!-- Scrollable content -->
    <ScrollView
        android:id="@+id/scrollBoxDetails"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_20"
            android:paddingEnd="@dimen/spacing_20"
            android:paddingBottom="@dimen/spacing_20">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="@dimen/corner_xl"
                app:cardElevation="@dimen/elevation_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_18">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvDetailsBoxName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/placeholder_box_name"
                        android:textColor="@color/smartmove_text_primary"
                        android:textSize="@dimen/text_size_title"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvDetailsBoxNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:text="@string/placeholder_box_number"
                        android:textColor="@color/smartmove_text_secondary"
                        android:textSize="@dimen/text_size_subtitle_sm" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvDetailsPriority"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/height_chip"
                            android:background="@drawable/bg_priority_yellow"
                            android:gravity="center"
                            android:paddingStart="@dimen/spacing_12"
                            android:paddingEnd="@dimen/spacing_12"
                            android:text="@string/priority_yellow"
                            android:textColor="@android:color/white"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvDetailsStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/height_chip"
                            android:layout_marginStart="@dimen/spacing_8"
                            android:background="@drawable/bg_chip_soft"
                            android:gravity="center"
                            android:paddingStart="@dimen/spacing_12"
                            android:paddingEnd="@dimen/spacing_12"
                            android:text="@string/placeholder_status"
                            android:textColor="@color/smartmove_text_primary"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="@dimen/corner_xl"
                app:cardElevation="@dimen/elevation_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_18">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/box_general_info"
                        android:textColor="@color/smartmove_text_primary"
                        android:textSize="@dimen/text_size_subtitle"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvDetailsRoom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_14"
                        android:text="@string/placeholder_room"
                        android:textColor="@color/smartmove_text_primary"
                        android:textSize="@dimen/text_size_body_lg" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvDetailsFragile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_10"
                        android:text="@string/placeholder_fragile"
                        android:textColor="@color/smartmove_text_primary"
                        android:textSize="@dimen/text_size_body_lg" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvDetailsValuable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_10"
                        android:text="@string/placeholder_valuable"
                        android:textColor="@color/smartmove_text_primary"
                        android:textSize="@dimen/text_size_body_lg" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:layout_marginBottom="@dimen/spacing_20"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="@dimen/corner_xl"
                app:cardElevation="@dimen/elevation_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_18">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/box_items_label"
                        android:textColor="@color/smartmove_text_primary"
                        android:textSize="@dimen/text_size_subtitle"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvDetailsItems"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_14"
                        android:text="@string/placeholder_items"
                        android:textColor="@color/smartmove_text_primary"
                        android:textSize="@dimen/text_size_body_lg" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnMarkOpened"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/height_input"
                        android:layout_marginTop="@dimen/spacing_18"
                        android:background="@drawable/bg_mark_opened_button"
                        android:text="@string/btn_mark_opened"
                        android:textColor="@color/priority_green_text"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnEditBox"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/height_input"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:background="@drawable/bg_secondary_button"
                        android:text="@string/btn_edit_box"
                        android:textColor="@color/button_primary_color"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
