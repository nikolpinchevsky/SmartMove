<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_login_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="@dimen/spacing_24"
        android:paddingEnd="@dimen/spacing_24"
        android:paddingTop="@dimen/spacing_22"
        android:paddingBottom="@dimen/spacing_24">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivHero"
            android:layout_width="@dimen/size_hero_signup_width"
            android:layout_height="@dimen/size_hero_signup_height"
            android:src="@drawable/smartmove_hero"
            android:scaleType="fitCenter"
            android:contentDescription="@string/cd_hero_image" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_10"
            android:text="@string/signup_title"
            android:textColor="@color/smartmove_text_primary"
            android:textSize="@dimen/text_size_header"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_6"
            android:text="@string/signup_subtitle"
            android:textColor="@color/smartmove_text_secondary"
            android:textSize="@dimen/text_size_body_lg" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardSignUp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_22"
            android:elevation="@dimen/elevation_card_2xl"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="@dimen/corner_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_18">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_input"
                    android:layout_marginBottom="@dimen/spacing_12"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_14"
                    android:paddingEnd="@dimen/spacing_14">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/size_icon_input"
                        android:layout_height="@dimen/size_icon_input"
                        android:src="@drawable/ic_person"
                        android:contentDescription="@string/cd_name_icon" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etFullName"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_10"
                        android:background="@android:color/transparent"
                        android:hint="@string/hint_full_name"
                        android:inputType="textPersonName"
                        android:textColor="@color/smartmove_text_primary"
                        android:textColorHint="@color/smartmove_text_secondary"
                        android:textSize="@dimen/text_size_body_lg" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_input"
                    android:layout_marginBottom="@dimen/spacing_12"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_14"
                    android:paddingEnd="@dimen/spacing_14">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/size_icon_input"
                        android:layout_height="@dimen/size_icon_input"
                        android:src="@drawable/ic_email"
                        android:contentDescription="@string/cd_email_icon" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etEmail"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_10"
                        android:background="@android:color/transparent"
                        android:hint="@string/hint_email"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/smartmove_text_primary"
                        android:textColorHint="@color/smartmove_text_secondary"
                        android:textSize="@dimen/text_size_body_lg" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_input"
                    android:layout_marginBottom="@dimen/spacing_12"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_14"
                    android:paddingEnd="@dimen/spacing_14">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/size_icon_input"
                        android:layout_height="@dimen/size_icon_input"
                        android:src="@drawable/ic_lock"
                        android:contentDescription="@string/cd_password_icon" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_10"
                        android:background="@android:color/transparent"
                        android:hint="@string/hint_password"
                        android:inputType="textPassword"
                        android:textColor="@color/smartmove_text_primary"
                        android:textColorHint="@color/smartmove_text_secondary"
                        android:textSize="@dimen/text_size_body_lg" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCreateAccount"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_button_primary"
                    android:layout_marginTop="@dimen/spacing_18"
                    android:background="@drawable/bg_primary_button"
                    android:text="@string/btn_create_account"
                    android:textAllCaps="false"
                    android:textColor="@color/smartmove_text_secondary"
                    android:textSize="@dimen/text_size_subtitle"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvBackToLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/spacing_18"
                    android:text="@string/btn_back_to_login"
                    android:textColor="@color/button_primary_color"
                    android:textSize="@dimen/text_size_body_lg"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
