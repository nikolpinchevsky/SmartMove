<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Pinned header: back arrow + title/subtitle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_8"
        android:paddingTop="@dimen/spacing_16"
        android:paddingEnd="@dimen/spacing_20"
        android:paddingBottom="@dimen/spacing_8">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back_button"
            android:padding="@dimen/spacing_12"
            android:src="@drawable/ic_back_arrow" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_4"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit_box_title"
                android:textColor="@color/smartmove_text_primary"
                android:textSize="@dimen/text_size_header"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:text="@string/edit_box_subtitle"
                android:textColor="@color/smartmove_text_secondary"
                android:textSize="@dimen/text_size_body" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_20"
            android:paddingEnd="@dimen/spacing_20"
            android:paddingBottom="@dimen/spacing_20">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="@dimen/corner_xl"
                app:cardElevation="@dimen/elevation_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_18">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/box_general_info"
                        android:textColor="@color/smartmove_text_primary"
                        android:textSize="@dimen/text_size_subtitle"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etEditBoxName"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/height_input_edit"
                        android:layout_marginTop="@dimen/spacing_14"
                        android:background="@drawable/bg_chip_soft"
                        android:hint="@string/hint_box_name_edit"
                        android:paddingStart="@dimen/spacing_14"
                        android:paddingEnd="@dimen/spacing_14"
                        android:textColor="@color/smartmove_text_primary"
                        android:textColorHint="@color/smartmove_text_secondary" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etEditRoom"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/height_input_edit"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:background="@drawable/bg_chip_soft"
                        android:hint="@string/hint_room_edit"
                        android:paddingStart="@dimen/spacing_14"
                        android:paddingEnd="@dimen/spacing_14"
                        android:textColor="@color/smartmove_text_primary"
                        android:textColorHint="@color/smartmove_text_secondary" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etEditItems"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/height_input_edit"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:background="@drawable/bg_chip_soft"
                        android:hint="@string/hint_items_edit"
                        android:paddingStart="@dimen/spacing_14"
                        android:paddingEnd="@dimen/spacing_14"
                        android:textColor="@color/smartmove_text_primary"
                        android:textColorHint="@color/smartmove_text_secondary" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="@dimen/corner_xl"
                app:cardElevation="@dimen/elevation_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_18">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/add_priority_label"
                        android:textColor="@color/smartmove_text_primary"
                        android:textSize="@dimen/text_size_subtitle"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_14"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/chipEditRed"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/height_chip"
                            android:background="@drawable/bg_chip_soft"
                            android:gravity="center"
                            android:paddingStart="@dimen/spacing_14"
                            android:paddingEnd="@dimen/spacing_14"
                            android:text="@string/priority_red"
                            android:textColor="@color/smartmove_text_primary"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/chipEditYellow"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/height_chip"
                            android:layout_marginStart="@dimen/spacing_8"
                            android:background="@drawable/bg_chip_soft"
                            android:gravity="center"
                            android:paddingStart="@dimen/spacing_14"
                            android:paddingEnd="@dimen/spacing_14"
                            android:text="@string/priority_yellow"
                            android:textColor="@color/smartmove_text_primary"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/chipEditGreen"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/height_chip"
                            android:layout_marginStart="@dimen/spacing_8"
                            android:background="@drawable/bg_chip_soft"
                            android:gravity="center"
                            android:paddingStart="@dimen/spacing_14"
                            android:paddingEnd="@dimen/spacing_14"
                            android:text="@string/priority_green"
                            android:textColor="@color/smartmove_text_primary"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="@dimen/corner_xl"
                app:cardElevation="@dimen/elevation_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_18">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/box_attributes_label"
                        android:textColor="@color/smartmove_text_primary"
                        android:textSize="@dimen/text_size_subtitle"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_14"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_fragile"
                                android:textColor="@color/smartmove_text_primary"
                                android:textStyle="bold" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_2"
                                android:text="@string/label_fragile_desc"
                                android:textColor="@color/smartmove_text_secondary"
                                android:textSize="@dimen/text_size_sm" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchFragile"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_valuable"
                                android:textColor="@color/smartmove_text_primary"
                                android:textStyle="bold" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_2"
                                android:text="@string/label_valuable_desc"
                                android:textColor="@color/smartmove_text_secondary"
                                android:textSize="@dimen/text_size_sm" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchValuable"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSaveBoxChanges"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_button_primary"
                android:layout_marginTop="@dimen/spacing_20"
                android:layout_marginBottom="@dimen/spacing_20"
                android:background="@drawable/bg_primary_button"
                android:text="@string/btn_save_changes"
                android:textColor="@color/smartmove_text_secondary"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
